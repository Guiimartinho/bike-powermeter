# https://editorconfig.org
root = true

# Código novo (port Zephyr, scripts, documentação)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
max_line_length = 100

[*.{md,markdown}]
# Duas barras de espaço no fim da linha são quebra de linha no Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{CMakeLists.txt,*.cmake}]
indent_size = 4

# Código herdado do stravaV10: só referência, preserve o formato original (tabs).
[{legacy,libraries,tools}/**]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false

# Ferramentas do projeto dentro de tools/ (o resto de tools/ é herdado do stravaV10).
[tools/{fw,docs}/**]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Projeto da placa: nunca reescrever.
[hardware/**]
charset = unset
end_of_line = unset
indent_style = unset
trim_trailing_whitespace = false
insert_final_newline = false
