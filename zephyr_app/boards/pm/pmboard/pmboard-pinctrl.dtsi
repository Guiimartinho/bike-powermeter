/*
 * Pin map of the crank pod board: docs/02-hardware.md, "Pinos do módulo".
 *
 * Two rules of the nRF54LM20A (datasheet 4539_001 v1.0) shape it:
 *
 *   - Clock pins. The SCL of a TWIM and the SCK of a SPIM only work on
 *     P0.03, P0.04, P0.06, P0.07, P1.03, P1.04, P1.07, P1.13, P1.14, P1.17,
 *     P1.18, P1.23, P1.24, P2.01, P2.06, P3.03 and P3.04 (table 79). The
 *     two buses here take P2.01 and P1.03.
 *   - NFC pads. P1.01 (NFC1) and P1.02 (NFC2) leave reset as antenna pins
 *     with the GPIO function off. Nothing here uses them.
 *
 * P1.20 and P1.21 carry the 32,768 kHz crystal of the module. The serial
 * blocks follow the power domains of the part: spi00 on port P2, block 20
 * and block 23 on port P1.
 *
 * Every pin below is a pad of the MinewSemi ME54BS13 (datasheet V1.0.0,
 * pages 6 to 9), as the table of docs/02 lists them.
 */

&pinctrl {
	/* ---- Bridge converter and accelerometer: spi00, the fast SPI of port P2 ---- */
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};

	/* ---- Temperature sensor and fuel gauge: SCL on P1.03, a clock pin ---- */
	i2c23_default: i2c23_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 29)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			bias-pull-up;
		};
	};

	i2c23_sleep: i2c23_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 29)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};

	/* ---- Console on two test pads ---- */
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 31)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>,
				<NRF_PSEL(UART_RX, 1, 31)>;
			low-power-enable;
		};
	};
};
